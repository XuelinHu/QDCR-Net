{
  "experiment_name": "qdcr_ruod_tuned_full_smoke",
  "output_dir": "outputs/checkpoints/qdcr_ruod_tuned_full_smoke",
  "runs_dir": "runs/qdcr_ruod_tuned_full_smoke",
  "device": "cuda",
  "seed": 42,
  "dataset": {
    "name": "ruod",
    "train_root": "data/datasets/downloads/RUOD/RUOD/train/images",
    "val_root": "data/datasets/downloads/RUOD/RUOD/valid/images",
    "enhanced_root": "data/datasets/downloads/RUOD/RUOD/train/images",
    "num_classes": 4,
    "image_size": 640,
    "max_objects": 16,
    "workers": 4,
    "prefetch_factor": 2,
    "cache_preprocessed": false,
    "cache_dir": "/tmp/qdcr_preprocessed/ruod_smoke"
  },
  "model": {
    "name": "qdcr_net",
    "feature_dim": 64,
    "num_queries": 16,
    "quality_aware": true,
    "cross_residual_mode": "vanilla",
    "cross_residual_threshold_init": 0.1,
    "cross_residual_threshold_slope": 10.0,
    "cross_residual_sparse_mode": "soft_threshold",
    "cross_residual_sparse_lambda_init": 0.1,
    "cross_residual_topk_ratio": 0.5,
    "cross_residual_stages": [
      "stage2",
      "stage3"
    ],
    "small_object_neck": true
  },
  "train": {
    "epochs": 1,
    "batch_size": 100,
    "optimizer": "adamw",
    "learning_rate": 0.0003,
    "weight_decay": 0.0005,
    "max_batches_per_epoch": 2,
    "log_interval": 1,
    "scalar_log_interval": 1,
    "eval_interval": 1,
    "amp": true,
    "log_graph": false,
    "log_histograms": false,
    "pin_memory": true,
    "persistent_workers": true,
    "early_stopping": {
      "enabled": false,
      "monitor": "loss",
      "mode": "min",
      "patience": 15,
      "min_delta": 0.0005
    }
  },
  "eval": {
    "checkpoint": "best",
    "max_batches": 1,
    "conf_thresh": 0.05,
    "iou_thresh": 0.5
  },
  "loss": {
    "name": "DetectionLoss",
    "box_weight": 5.0,
    "iou_weight": 2.0,
    "focal_gamma": 2.0,
    "background_weight": 0.2,
    "box_regression": "SmoothL1Loss"
  }
}