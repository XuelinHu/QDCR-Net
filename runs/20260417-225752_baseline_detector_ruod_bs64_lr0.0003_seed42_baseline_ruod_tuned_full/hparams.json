{
  "experiment": "baseline_ruod_tuned_full",
  "model": "baseline_detector",
  "dataset": "ruod",
  "batch_size": 64,
  "learning_rate": 0.0003,
  "epochs": 120,
  "optimizer": "adamw",
  "scheduler": "none",
  "seed": 42,
  "device": "cuda",
  "weight_decay": 0.0005,
  "image_size": 640,
  "feature_dim": 64,
  "num_queries": 16,
  "cross_residual_mode": "vanilla",
  "cross_residual_threshold_init": 0.1,
  "cross_residual_threshold_slope": 10.0,
  "cross_residual_sparse_mode": "soft_threshold",
  "cross_residual_sparse_lambda_init": 0.1,
  "cross_residual_topk_ratio": 0.5,
  "conf_thresh": 0.05,
  "iou_thresh": 0.5,
  "early_stop_monitor": "loss",
  "loss_box_weight": 5.0,
  "loss_iou_weight": 2.0,
  "loss_focal_gamma": 2.0,
  "loss_background_weight": 0.2
}